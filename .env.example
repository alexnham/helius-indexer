# Optional Docker console port. Set both the published and internal port.
# Leave provider keys out: this captured-data console does not need them.
INDEXER_CONSOLE_PORT=8765

# Provider-backed runtime (explicit `--profile live up runtime` only).
# Store HELIUS_API_KEY in a separate ignored file, then set INDEXER_SECRET_FILE
# to that path. Existing untracked .env is also supported as the secret file.
INDEXER_RUNTIME_PORT=8767
# Set to 0 to reopen existing runtime data without any provider calls.
INDEXER_RUN=1
INDEXER_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
INDEXER_LIVE_SECONDS=60
INDEXER_REPLAY_JOB=recent
INDEXER_BACKFILL_SLOTS=50
# Continuous runtime keeps only this many newest transfers; older data is deleted.
INDEXER_KEEP_TRANSFERS=1000
# 1 makes a fresh session a 10% sampled single-mint demo (no pruning); see docs/runtime-testing.md.
INDEXER_SAMPLE=0
# Optional inclusive explicit slot range; at most 128 slots per invocation:
# INDEXER_BACKFILL_START=...
# INDEXER_BACKFILL_END=...
# INDEXER_LIVE_FROM=...

# Local PostgreSQL container (`docker compose up -d postgres`).
# INDEXER_POSTGRES_PORT=55432
# INDEXER_POSTGRES_PASSWORD=indexer
# Apply schema migrations with: DATABASE_URL=postgres://indexer:indexer@127.0.0.1:55432/indexer helius-indexer migrate SESSION

# Hosted PostgreSQL (non-loopback) always requires TLS with an authenticated server:
# by default a trusted chain plus hostname (system roots, or a PEM file below).
# INDEXER_DB_TLS_ROOT=/path/to/provider-ca.pem
# For a self-signed server (for example Railway, whose leaf is CN=localhost), pin the
# leaf certificate instead. Obtain it out of band and re-pin after certificate rotation:
#   openssl s_client -starttls postgres -connect HOST:PORT </dev/null | openssl x509 -noout -fingerprint -sha256
# INDEXER_DB_TLS_SHA256=AA:BB:...

# Local Kafka (`docker compose up -d kafka`), the durable live intake log (#36).
# INDEXER_KAFKA_PORT=59092
# INDEXER_KAFKA_BROKERS=127.0.0.1:59092
